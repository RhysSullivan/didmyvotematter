[Unit]
Description=Refresh didmyvotematter.com with the latest results
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/agent-workspace/decided-by
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/agent-workspace/decided-by/scripts/refresh.sh
TimeoutStartSec=15min
